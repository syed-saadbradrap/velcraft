# Vercel → Settings → Environment Variables (Production + Preview)
# After changing these, Redeploy so Next inlines NEXT_PUBLIC_* at build time.
#
# Leave NEXT_PUBLIC_API_URL unset (or set to /api/v1) so the browser uses the
# same-origin rewrite in next.config.ts. Do NOT point the browser at rpsspvt.com
# directly — Imunify360 blocks cross-origin login with "Unable to reach the store".

NEXT_PUBLIC_SITE_URL=https://velcraft-pearl.vercel.app
# NEXT_PUBLIC_API_URL=/api/v1
VELCRAFT_API_ORIGIN=https://rpsspvt.com
NEXT_PUBLIC_USE_PRODUCTION_MODELS=false
